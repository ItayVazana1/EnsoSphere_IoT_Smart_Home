{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnsoSphere state_json",
  "type": "object",
  "required": [
    "timestamp",
    "simulation_time",
    "season",
    "is_daytime",
    "temperature",
    "weather",
    "occupants",
    "rooms",
    "house_status",
    "sensors",
    "notes"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "simulation_time": {
      "type": "string"
    },
    "season": {
      "type": "string",
      "enum": ["Winter", "Spring", "Summer", "Autumn"]
    },
    "is_daytime": {
      "type": "boolean"
    },
    "temperature": {
      "type": "number"
    },
    "weather": {
      "type": "string"
    },
    "occupants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "location"],
        "properties": {
          "name": { "type": "string" },
          "location": { "type": "string" }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "occupants"],
        "properties": {
          "name": { "type": "string" },
          "occupants": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "house_status": {
      "type": "object",
      "required": ["is_empty", "active_rooms", "room_state"],
      "properties": {
        "is_empty": { "type": "boolean" },
        "active_rooms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "room_state": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["active"],
            "properties": {
              "active": { "type": "boolean" }
            }
          }
        }
      }
    },
    "sensors": {
      "type": "object",
      "additionalProperties": {
        "type": ["boolean", "number", "string", "null"]
      }
    },
    "notes": {
      "type": "object",
      "properties": {
        "source": { "type": "string" }
      }
    }
  }
}
