###########################################
# EnsoSphere - Simulator Configuration
###########################################

# Tick settings
TICK_INTERVAL_SIMULATOR=3
TICK_INTERVAL_CORELOGIC=10
TICK_BATCH_SIZE=1
MAX_TICKS=48
# 'MAX_TICKS' - Simulate one full day (48 ticks of 30 min each)

# Simulation parameters
SIM_START_DATETIME=
# Leave 'SIM_START_DATETIME' blank for random date/season
SIM_CHARACTERS=David,Mishel,Kobe,Gavriella,Luna

###########################################
# Database Configuration (MySQL)
###########################################

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=ensosphere
MYSQL_USER=user
MYSQL_PASSWORD=password

###########################################
# MQTT Configuration
###########################################

MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_KEEPALIVE=60

###########################################
# Output Mode
###########################################
CORE_LOGIC_CONCISE_MODE=False
SIMULATOR_CONCISE_MODE=True
MQTT_PUBLISHER_CONCISE_MODE=True
MQTT_LISTENER_CONCISE_MODE=true

# True = quiet mode (minimal printing)
